<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FinanSmart - Gestão Financeira Pessoal</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Google Fonts Inter -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex flex-col transition-colors duration-300">

    <!-- Top Navbar -->
    <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 flex items-center justify-center shadow-lg shadow-emerald-500/20">
                    <i data-lucide="wallet" class="w-6 h-6 text-slate-950"></i>
                </div>
                <div>
                    <span class="text-xl font-bold bg-gradient-to-r from-emerald-400 to-teal-300 bg-clip-text text-transparent">FinanSmart</span>
                    <span class="block text-xs text-slate-400">Gestão Pessoal Inteligente</span>
                </div>
            </div>
            
            <div class="flex items-center space-x-4">
                <button onclick="toggleDarkMode()" class="p-2 rounded-lg bg-slate-700/50 hover:bg-slate-700 text-slate-300 transition" title="Alternar Tema">
                    <i data-lucide="sun" id="theme-icon" class="w-5 h-5"></i>
                </button>
                <div class="h-6 w-px bg-slate-700"></div>
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center font-bold text-sm border border-emerald-500/30">
                        US
                    </div>
                    <span class="text-sm font-medium hidden sm:inline text-slate-300">Minha Conta</span>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
        
        <!-- Navigation Tabs -->
        <div class="flex space-x-2 border-b border-slate-700/60 pb-2 overflow-x-auto">
            <button onclick="switchTab('dashboard')" id="btn-dashboard" class="tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 bg-emerald-600 text-white shadow-md shadow-emerald-600/20 transition">
                <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                <span>Dashboard</span>
            </button>
            <button onclick="switchTab('transactions')" id="btn-transactions" class="tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800 transition">
                <i data-lucide="arrow-left-right" class="w-4 h-4"></i>
                <span>Transações</span>
            </button>
            <button onclick="switchTab('budgets')" id="btn-budgets" class="tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800 transition">
                <i data-lucide="target" class="w-4 h-4"></i>
                <span>Orçamentos & Metas</span>
            </button>
        </div>

        <!-- TAB 1: DASHBOARD -->
        <div id="tab-dashboard" class="space-y-8">
            
            <!-- Charts Section (Evolução Financeira posicionado acima dos cards) -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Fluxo de Caixa / Evolução Mensal -->
                <div class="lg:col-span-2 bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-semibold text-base text-white flex items-center space-x-2">
                            <i data-lucide="line-chart" class="w-5 h-5 text-emerald-400"></i>
                            <span>Evolução Financeira (Últimos 6 meses)</span>
                        </h4>
                    </div>
                    <div class="h-72 relative">
                        <canvas id="cashflowChart"></canvas>
                    </div>
                </div>

                <!-- Rosca: Gastos por Categoria -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm flex flex-col justify-between">
                    <div>
                        <h4 class="font-semibold text-base text-white flex items-center space-x-2 mb-4">
                            <i data-lucide="pie-chart" class="w-5 h-5 text-emerald-400"></i>
                            <span>Gastos por Categoria</span>
                        </h4>
                        <div class="h-56 relative flex items-center justify-center">
                            <canvas id="categoryChart"></canvas>
                        </div>
                    </div>
                    <div id="category-legend" class="mt-4 space-y-2 max-h-32 overflow-y-auto text-xs"></div>
                </div>
            </div>

            <!-- Summary Cards -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <!-- Saldo Total -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                    <div class="absolute right-4 top-4 p-3 bg-blue-500/10 text-blue-400 rounded-xl">
                        <i data-lucide="wallet" class="w-6 h-6"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-400">Saldo Total</p>
                    <h3 id="card-total-balance" class="text-2xl font-bold mt-2 text-white">R$ 0,00</h3>
                    <div class="flex items-center mt-2 text-xs text-emerald-400 space-x-1">
                        <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
                        <span>Sincronizado na Nuvem</span>
                    </div>
                </div>

                <!-- Receitas do Mês -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                    <div class="absolute right-4 top-4 p-3 bg-emerald-500/10 text-emerald-400 rounded-xl">
                        <i data-lucide="arrow-down-left" class="w-6 h-6"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-400">Receitas do Mês</p>
                    <h3 id="card-monthly-income" class="text-2xl font-bold mt-2 text-emerald-400">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-2">Entradas registradas</p>
                </div>

                <!-- Despesas do Mês -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                    <div class="absolute right-4 top-4 p-3 bg-rose-500/10 text-rose-400 rounded-xl">
                        <i data-lucide="arrow-up-right" class="w-6 h-6"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-400">Despesas do Mês</p>
                    <h3 id="card-monthly-expense" class="text-2xl font-bold mt-2 text-rose-400">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-2">Saídas registradas</p>
                </div>

                <!-- Economia / Investimentos -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                    <div class="absolute right-4 top-4 p-3 bg-purple-500/10 text-purple-400 rounded-xl">
                        <i data-lucide="piggy-bank" class="w-6 h-6"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-400">Economia Líquida</p>
                    <h3 id="card-savings" class="text-2xl font-bold mt-2 text-purple-400">R$ 0,00</h3>
                    <p class="text-xs text-slate-400 mt-2">Receitas - Despesas</p>
                </div>
            </div>

            <!-- Quick Add Bar & Recent Transactions Preview -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Form de Adição Rápida -->
                <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm">
                    <h4 class="font-semibold text-base text-white mb-4 flex items-center space-x-2">
                        <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-400"></i>
                        <span>Nova Transação Rápida</span>
                    </h4>
                    <form id="quick-transaction-form" onsubmit="handleQuickAdd(event)" class="space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Tipo</label>
                            <div class="grid grid-cols-2 gap-2">
                                <button type="button" id="type-expense" onclick="setTxType('expense')" class="py-2 rounded-xl text-sm font-medium border border-rose-500/50 bg-rose-500/20 text-rose-400 transition">Despesa</button>
                                <button type="button" id="type-income" onclick="setTxType('income')" class="py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition">Receita</button>
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Descrição</label>
                            <input type="text" id="tx-desc" required placeholder="Ex: Supermercado" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                        </div>
                        <div class="grid grid-cols-2 gap-2">
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">Valor (R$)</label>
                                <input type="number" step="0.01" id="tx-amount" required placeholder="0.00" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-medium text-slate-400 mb-1">Data</label>
                                <input type="date" id="tx-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-slate-400 mb-1">Categoria</label>
                            <select id="tx-category" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                                <!-- Preenchido dinamicamente -->
                            </select>
                        </div>
                        <button type="submit" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2.5 rounded-xl shadow-lg shadow-emerald-600/20 transition flex items-center justify-center space-x-2">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            <span>Adicionar Transação</span>
                        </button>
                    </form>
                </div>

                <!-- Transações Recentes -->
                <div class="lg:col-span-2 bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h4 class="font-semibold text-base text-white flex items-center space-x-2">
                            <i data-lucide="history" class="w-5 h-5 text-emerald-400"></i>
                            <span>Últimas Transações</span>
                        </h4>
                        <button onclick="switchTab('transactions')" class="text-xs text-emerald-400 hover:underline">Ver todas</button>
                    </div>
                    <div id="recent-transactions-list" class="space-y-3 flex-1 overflow-y-auto max-h-[340px]">
                        <!-- Preenchido via JS -->
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: TRANSAÇÕES -->
        <div id="tab-transactions" class="hidden space-y-6">
            <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm space-y-6">
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                    <h3 class="text-lg font-bold text-white flex items-center space-x-2">
                        <i data-lucide="arrow-left-right" class="w-5 h-5 text-emerald-400"></i>
                        <span>Gerenciamento de Transações</span>
                    </h3>
                    <button onclick="openTransactionModal()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-xl text-sm font-medium flex items-center space-x-2 shadow-lg shadow-emerald-600/20 transition">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span>Nova Transação</span>
                    </button>
                </div>

                <!-- Filtros -->
                <div class="grid grid-cols-1 sm:grid-cols-4 gap-3 bg-slate-900/60 p-4 rounded-xl border border-slate-700/50">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Pesquisar</label>
                        <input type="text" id="filter-search" oninput="renderTransactionsTable()" placeholder="Buscar descrição..." class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Tipo</label>
                        <select id="filter-type" onchange="renderTransactionsTable()" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="all">Todos</option>
                            <option value="income">Receita</option>
                            <option value="expense">Despesa</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Categoria</label>
                        <select id="filter-category" onchange="renderTransactionsTable()" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                            <option value="all">Todas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Mês / Ano</label>
                        <input type="month" id="filter-month" onchange="renderTransactionsTable()" class="w-full bg-slate-950 border border-slate-700 rounded-lg px-3 py-1.5 text-xs text-white focus:outline-none focus:border-emerald-500">
                    </div>
                </div>

                <!-- Tabela de Transações -->
                <div class="overflow-x-auto rounded-xl border border-slate-700/80">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-900/80 border-b border-slate-700 text-xs font-semibold text-slate-400">
                                <th class="p-4">Data</th>
                                <th class="p-4">Descrição</th>
                                <th class="p-4">Categoria</th>
                                <th class="p-4">Tipo</th>
                                <th class="p-4 text-right">Valor</th>
                                <th class="p-4 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="transactions-table-body" class="divide-y divide-slate-700/50 text-sm">
                            <!-- Preenchido via JS -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- TAB 3: ORÇAMENTOS E METAS -->
        <div id="tab-budgets" class="hidden space-y-6">
            <div class="bg-slate-800/60 border border-slate-700/80 rounded-2xl p-6 shadow-sm space-y-6">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 class="text-lg font-bold text-white flex items-center space-x-2">
                            <i data-lucide="target" class="w-5 h-5 text-emerald-400"></i>
                            <span>Orçamento e Limites por Categoria</span>
                        </h3>
                        <p class="text-xs text-slate-400 mt-1">Defina limites mensais para controlar seus gastos em cada categoria.</p>
                    </div>
                </div>

                <div id="budgets-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                    <!-- Preenchido via JS -->
                </div>
            </div>
        </div>

    </main>

    <!-- Modal Nova Transação -->
    <div id="transaction-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
        <div class="bg-slate-800 border border-slate-700 w-full max-w-md rounded-2xl p-6 shadow-2xl space-y-4">
            <div class="flex items-center justify-between border-b border-slate-700 pb-3">
                <h3 class="text-base font-bold text-white flex items-center space-x-2">
                    <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-400"></i>
                    <span>Nova Transação</span>
                </h3>
                <button onclick="closeTransactionModal()" class="text-slate-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
            </div>
            <form id="modal-transaction-form" onsubmit="handleModalAdd(event)" class="space-y-4">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Tipo</label>
                    <div class="grid grid-cols-2 gap-2">
                        <button type="button" id="modal-type-expense" onclick="setModalTxType('expense')" class="py-2 rounded-xl text-sm font-medium border border-rose-500/50 bg-rose-500/20 text-rose-400 transition">Despesa</button>
                        <button type="button" id="modal-type-income" onclick="setModalTxType('income')" class="py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition">Receita</button>
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Descrição</label>
                    <input type="text" id="modal-tx-desc" required placeholder="Ex: Conta de Luz" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                </div>
                <div class="grid grid-cols-2 gap-2">
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Valor (R$)</label>
                        <input type="number" step="0.01" id="modal-tx-amount" required placeholder="0.00" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-slate-400 mb-1">Data</label>
                        <input type="date" id="modal-tx-date" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                    </div>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Categoria</label>
                    <select id="modal-tx-category" required class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-white focus:outline-none focus:border-emerald-500">
                        <!-- Preenchido dinamicamente -->
                    </select>
                </div>
                <div class="flex space-x-3 pt-2">
                    <button type="button" onclick="closeTransactionModal()" class="flex-1 bg-slate-700 hover:bg-slate-600 text-white font-medium py-2.5 rounded-xl transition">Cancelar</button>
                    <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-500 text-white font-medium py-2.5 rounded-xl shadow-lg shadow-emerald-600/20 transition">Salvar</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Application Scripts with Firebase Firestore Realtime Sync -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
        import { getFirestore, collection, addDoc, deleteDoc, doc, onSnapshot } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        const firebaseConfig = {
            apiKey: "AIzaSyAawgQrQl-dsVtlP-Wp69Uk-WdpXES8sy8",
            authDomain: "gestaofinanceira-pessoal.firebaseapp.com",
            projectId: "gestaofinanceira-pessoal",
            storageBucket: "gestaofinanceira-pessoal.firebasestorage.app",
            messagingSenderId: "228007119683",
            appId: "1:228007119683:web:b6f9c89ef884b9ba36bdf6"
        };

        const app = initializeApp(firebaseConfig);
        const db = getFirestore(app);

        // Dados Padrão de Categorias
        const defaultCategories = [
            { id: 'moradia', name: 'Moradia', type: 'expense', color: '#3b82f6', icon: 'home', budget: 1500 },
            { id: 'alimentacao', name: 'Alimentação', type: 'expense', color: '#10b981', icon: 'utensils', budget: 800 },
            { id: 'transporte', name: 'Transporte', type: 'expense', color: '#f59e0b', icon: 'car', budget: 400 },
            { id: 'lazer', name: 'Lazer', type: 'expense', color: '#ec4899', icon: 'film', budget: 300 },
            { id: 'saude', name: 'Saúde', type: 'expense', color: '#ef4444', icon: 'heart-pulse', budget: 200 },
            { id: 'salario', name: 'Salário', type: 'income', color: '#22c55e', icon: 'briefcase', budget: 0 },
            { id: 'freelance', name: 'Freelance', type: 'income', color: '#14b8a6', icon: 'laptop', budget: 0 },
            { id: 'outros', name: 'Outros', type: 'expense', color: '#8b5cf6', icon: 'package', budget: 200 }
        ];

        let state = {
            transactions: [],
            categories: defaultCategories,
            quickType: 'expense',
            modalType: 'expense'
        };

        let categoryChartInstance = null;
        let cashflowChartInstance = null;

        window.onload = function() {
            const todayStr = new Date().toISOString().split('T')[0];
            document.getElementById('tx-date').value = todayStr;
            document.getElementById('modal-tx-date').value = todayStr;
            document.getElementById('filter-month').value = todayStr.substring(0, 7);

            populateCategorySelects();

            // Sincronização em tempo real com o Firestore
            onSnapshot(collection(db, "transactions"), (snapshot) => {
                state.transactions = [];
                snapshot.forEach((docSnap) => {
                    state.transactions.push({ id: docSnap.id, ...docSnap.data() });
                });
                state.transactions.sort((a, b) => new Date(b.date) - new Date(a.date));
                
                updateDashboard();
                renderTransactionsTable();
                renderBudgets();
            }, (error) => {
                console.error("Erro ao sincronizar com o Firestore: ", error);
            });

            lucide.createIcons();
        };

        window.switchTab = function(tabName) {
            document.getElementById('tab-dashboard').classList.add('hidden');
            document.getElementById('tab-transactions').classList.add('hidden');
            document.getElementById('tab-budgets').classList.add('hidden');

            document.getElementById('btn-dashboard').className = "tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800 transition";
            document.getElementById('btn-transactions').className = "tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800 transition";
            document.getElementById('btn-budgets').className = "tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 text-slate-400 hover:text-white hover:bg-slate-800 transition";

            document.getElementById(`tab-${tabName}`).classList.remove('hidden');
            document.getElementById(`btn-${tabName}`).className = "tab-btn px-4 py-2 rounded-lg font-medium text-sm flex items-center space-x-2 bg-emerald-600 text-white shadow-md shadow-emerald-600/20 transition";

            if (tabName === 'dashboard') {
                renderCharts();
            }
        };

        function populateCategorySelects() {
            const txCatSelect = document.getElementById('tx-category');
            const modalCatSelect = document.getElementById('modal-tx-category');
            const filterCatSelect = document.getElementById('filter-category');

            txCatSelect.innerHTML = '';
            modalCatSelect.innerHTML = '';
            filterCatSelect.innerHTML = '<option value="all">Todas</option>';

            state.categories.forEach(cat => {
                const opt1 = document.createElement('option');
                opt1.value = cat.id;
                opt1.textContent = `${cat.name} (${cat.type === 'income' ? 'Receita' : 'Despesa'})`;
                txCatSelect.appendChild(opt1);

                const opt2 = document.createElement('option');
                opt2.value = cat.id;
                opt2.textContent = `${cat.name} (${cat.type === 'income' ? 'Receita' : 'Despesa'})`;
                modalCatSelect.appendChild(opt2);

                const opt3 = document.createElement('option');
                opt3.value = cat.id;
                opt3.textContent = cat.name;
                filterCatSelect.appendChild(opt3);
            });

            filterCategoriesByTypeForQuick('expense');
            filterCategoriesByTypeForModal('expense');
        }

        function filterCategoriesByTypeForQuick(type) {
            const txCatSelect = document.getElementById('tx-category');
            txCatSelect.innerHTML = '';
            state.categories.filter(c => c.type === type).forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.id;
                opt.textContent = cat.name;
                txCatSelect.appendChild(opt);
            });
        }

        function filterCategoriesByTypeForModal(type) {
            const modalCatSelect = document.getElementById('modal-tx-category');
            modalCatSelect.innerHTML = '';
            state.categories.filter(c => c.type === type).forEach(cat => {
                const opt = document.createElement('option');
                opt.value = cat.id;
                opt.textContent = cat.name;
                modalCatSelect.appendChild(opt);
            });
        }

        window.setTxType = function(type) {
            state.quickType = type;
            const btnExp = document.getElementById('type-expense');
            const btnInc = document.getElementById('type-income');
            if (type === 'expense') {
                btnExp.className = "py-2 rounded-xl text-sm font-medium border border-rose-500/50 bg-rose-500/20 text-rose-400 transition";
                btnInc.className = "py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition";
            } else {
                btnInc.className = "py-2 rounded-xl text-sm font-medium border border-emerald-500/50 bg-emerald-500/20 text-emerald-400 transition";
                btnExp.className = "py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition";
            }
            filterCategoriesByTypeForQuick(type);
        };

        window.setModalTxType = function(type) {
            state.modalType = type;
            const btnExp = document.getElementById('modal-type-expense');
            const btnInc = document.getElementById('modal-type-income');
            if (type === 'expense') {
                btnExp.className = "py-2 rounded-xl text-sm font-medium border border-rose-500/50 bg-rose-500/20 text-rose-400 transition";
                btnInc.className = "py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition";
            } else {
                btnInc.className = "py-2 rounded-xl text-sm font-medium border border-emerald-500/50 bg-emerald-500/20 text-emerald-400 transition";
                btnExp.className = "py-2 rounded-xl text-sm font-medium border border-slate-700 text-slate-400 hover:bg-slate-700 transition";
            }
            filterCategoriesByTypeForModal(type);
        };

        window.handleQuickAdd = async function(e) {
            e.preventDefault();
            const desc = document.getElementById('tx-desc').value;
            const amount = parseFloat(document.getElementById('tx-amount').value);
            const date = document.getElementById('tx-date').value;
            const category = document.getElementById('tx-category').value;

            try {
                await addDoc(collection(db, "transactions"), {
                    desc,
                    amount,
                    type: state.quickType,
                    category,
                    date
                });
                document.getElementById('quick-transaction-form').reset();
                document.getElementById('tx-date').value = new Date().toISOString().split('T')[0];
            } catch (error) {
                console.error("Erro ao adicionar transação: ", error);
                alert("Erro ao salvar transação na nuvem.");
            }
        };

        window.openTransactionModal = function() {
            document.getElementById('transaction-modal').classList.remove('hidden');
        };

        window.closeTransactionModal = function() {
            document.getElementById('transaction-modal').classList.add('hidden');
        };

        window.handleModalAdd = async function(e) {
            e.preventDefault();
            const desc = document.getElementById('modal-tx-desc').value;
            const amount = parseFloat(document.getElementById('modal-tx-amount').value);
            const date = document.getElementById('modal-tx-date').value;
            const category = document.getElementById('modal-tx-category').value;

            try {
                await addDoc(collection(db, "transactions"), {
                    desc,
                    amount,
                    type: state.modalType,
                    category,
                    date
                });
                closeTransactionModal();
                document.getElementById('modal-transaction-form').reset();
                document.getElementById('modal-tx-date').value = new Date().toISOString().split('T')[0];
            } catch (error) {
                console.error("Erro ao adicionar transação pelo modal: ", error);
                alert("Erro ao salvar transação na nuvem.");
            }
        };

        window.deleteTransaction = async function(id) {
            if (confirm("Deseja realmente excluir esta transação?")) {
                try {
                    await deleteDoc(doc(db, "transactions", id));
                } catch (error) {
                    console.error("Erro ao excluir transação: ", error);
                    alert("Erro ao excluir transação da nuvem.");
                }
            }
        };

        function updateDashboard() {
            const currentMonth = new Date().toISOString().substring(0, 7);

            let totalBalance = 0;
            let monthlyIncome = 0;
            let monthlyExpense = 0;

            state.transactions.forEach(t => {
                if (t.type === 'income') {
                    totalBalance += t.amount;
                    if (t.date.startsWith(currentMonth)) monthlyIncome += t.amount;
                } else {
                    totalBalance -= t.amount;
                    if (t.date.startsWith(currentMonth)) monthlyExpense += t.amount;
                }
            });

            const savings = monthlyIncome - monthlyExpense;

            document.getElementById('card-total-balance').textContent = formatCurrency(totalBalance);
            document.getElementById('card-monthly-income').textContent = formatCurrency(monthlyIncome);
            document.getElementById('card-monthly-expense').textContent = formatCurrency(monthlyExpense);
            document.getElementById('card-savings').textContent = formatCurrency(savings);

            renderRecentTransactions();
            renderCharts();
        }

        function renderRecentTransactions() {
            const container = document.getElementById('recent-transactions-list');
            container.innerHTML = '';

            const recent = state.transactions.slice(0, 5);
            if (recent.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-500 text-center py-4">Nenhuma transação registrada na nuvem.</p>`;
                return;
            }

            recent.forEach(t => {
                const cat = state.categories.find(c => c.id === t.category) || { name: 'Geral', color: '#64748b', icon: 'tag' };
                const isIncome = t.type === 'income';

                const div = document.createElement('div');
                div.className = "flex items-center justify-between p-3 rounded-xl bg-slate-900/50 border border-slate-700/50";
                div.innerHTML = `
                    <div class="flex items-center space-x-3">
                        <div class="w-9 h-9 rounded-xl flex items-center justify-center" style="background-color: ${cat.color}20; color: ${cat.color}">
                            <i data-lucide="${cat.icon || 'tag'}" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <p class="text-sm font-medium text-white">${t.desc}</p>
                            <p class="text-xs text-slate-400">${cat.name} • ${formatDate(t.date)}</p>
                        </div>
                    </div>
                    <span class="text-sm font-bold ${isIncome ? 'text-emerald-400' : 'text-rose-400'}">
                        ${isIncome ? '+' : '-'} ${formatCurrency(t.amount)}
                    </span>
                `;
                container.appendChild(div);
            });
            lucide.createIcons();
        }

        window.renderTransactionsTable = function() {
            const tbody = document.getElementById('transactions-table-body');
            tbody.innerHTML = '';

            const search = document.getElementById('filter-search').value.toLowerCase();
            const type = document.getElementById('filter-type').value;
            const category = document.getElementById('filter-category').value;
            const month = document.getElementById('filter-month').value;

            let filtered = state.transactions.filter(t => {
                const matchesSearch = t.desc.toLowerCase().includes(search);
                const matchesType = type === 'all' || t.type === type;
                const matchesCategory = category === 'all' || t.category === category;
                const matchesMonth = !month || t.date.startsWith(month);
                return matchesSearch && matchesType && matchesCategory && matchesMonth;
            });

            if (filtered.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="text-center py-6 text-slate-500 text-sm">Nenhuma transação encontrada.</td></tr>`;
                return;
            }

            filtered.forEach(t => {
                const cat = state.categories.find(c => c.id === t.category) || { name: 'Geral', color: '#64748b', icon: 'tag' };
                const isIncome = t.type === 'income';

                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-800/40 transition";
                tr.innerHTML = `
                    <td class="p-4 text-xs text-slate-300">${formatDate(t.date)}</td>
                    <td class="p-4 text-sm font-medium text-white">${t.desc}</td>
                    <td class="p-4 text-xs">
                        <span class="inline-flex items-center space-x-1 px-2.5 py-1 rounded-full border border-slate-700" style="color: ${cat.color}; background-color: ${cat.color}15">
                            <i data-lucide="${cat.icon || 'tag'}" class="w-3 h-3"></i>
                            <span>${cat.name}</span>
                        </span>
                    </td>
                    <td class="p-4 text-xs">
                        <span class="px-2.5 py-1 rounded-full font-medium ${isIncome ? 'bg-emerald-500/10 text-emerald-400' : 'bg-rose-500/10 text-rose-400'}">
                            ${isIncome ? 'Receita' : 'Despesa'}
                        </span>
                    </td>
                    <td class="p-4 text-sm font-bold text-right ${isIncome ? 'text-emerald-400' : 'text-rose-400'}">
                        ${isIncome ? '+' : '-'} ${formatCurrency(t.amount)}
                    </td>
                    <td class="p-4 text-center">
                        <button onclick="deleteTransaction('${t.id}')" class="p-1.5 hover:bg-rose-500/20 text-rose-400 rounded-lg transition" title="Excluir">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
            lucide.createIcons();
        };

        function renderBudgets() {
            const container = document.getElementById('budgets-container');
            container.innerHTML = '';

            const currentMonth = new Date().toISOString().substring(0, 7);
            const expensesByCategory = {};
            state.transactions.filter(t => t.type === 'expense' && t.date.startsWith(currentMonth)).forEach(t => {
                expensesByCategory[t.category] = (expensesByCategory[t.category] || 0) + t.amount;
            });

            const expenseCategories = state.categories.filter(c => c.type === 'expense');

            expenseCategories.forEach(cat => {
                const spent = expensesByCategory[cat.id] || 0;
                const budget = cat.budget || 0;
                const percentage = budget > 0 ? Math.min(Math.round((spent / budget) * 100), 100) : 0;
                let barColor = 'bg-emerald-500';
                if (percentage > 80) barColor = 'bg-amber-500';
                if (percentage >= 100) barColor = 'bg-rose-500';

                const card = document.createElement('div');
                card.className = "bg-slate-900/60 border border-slate-700/60 rounded-xl p-5 space-y-4";
                card.innerHTML = `
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-3">
                            <div class="w-10 h-10 rounded-xl flex items-center justify-center" style="background-color: ${cat.color}20; color: ${cat.color}">
                                <i data-lucide="${cat.icon || 'tag'}" class="w-5 h-5"></i>
                            </div>
                            <div>
                                <h5 class="font-semibold text-sm text-white">${cat.name}</h5>
                                <p class="text-xs text-slate-400">Meta: ${formatCurrency(budget)}</p>
                            </div>
                        </div>
                        <span class="text-xs font-bold px-2 py-1 rounded bg-slate-800 text-slate-300">${percentage}%</span>
                    </div>
                    <div class="space-y-1">
                        <div class="flex justify-between text-xs">
                            <span class="text-slate-400">Gasto: <strong class="text-white">${formatCurrency(spent)}</strong></span>
                            <span class="text-slate-400">Restante: <strong class="${budget - spent < 0 ? 'text-rose-400' : 'text-emerald-400'}">${formatCurrency(budget - spent)}</strong></span>
                        </div>
                        <div class="w-full bg-slate-800 h-2.5 rounded-full overflow-hidden">
                            <div class="${barColor} h-2.5 rounded-full transition-all duration-500" style="width: ${percentage}%"></div>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        function renderCharts() {
            const currentMonth = new Date().toISOString().substring(0, 7);
            const expenseCats = state.categories.filter(c => c.type === 'expense');
            const catLabels = expenseCats.map(c => c.name);
            const catColors = expenseCats.map(c => c.color);
            
            const catData = expenseCats.map(c => {
                return state.transactions
                    .filter(t => t.type === 'expense' && t.category === c.id && t.date.startsWith(currentMonth))
                    .reduce((sum, t) => sum + t.amount, 0);
            });

            const ctxCategory = document.getElementById('categoryChart').getContext('2d');
            if (categoryChartInstance) categoryChartInstance.destroy();

            categoryChartInstance = new Chart(ctxCategory, {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catData,
                        backgroundColor: catColors,
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    cutout: '70%'
                }
            });

            const legendContainer = document.getElementById('category-legend');
            legendContainer.innerHTML = '';
            expenseCats.forEach((c, index) => {
                const val = catData[index];
                if (val > 0) {
                    const item = document.createElement('div');
                    item.className = "flex items-center justify-between text-slate-300";
                    item.innerHTML = `
                        <div class="flex items-center space-x-2">
                            <span class="w-3 h-3 rounded-full" style="background-color: ${c.color}"></span>
                            <span>${c.name}</span>
                        </div>
                        <span class="font-semibold">${formatCurrency(val)}</span>
                    `;
                    legendContainer.appendChild(item);
                }
            });

            const months = [];
            const incomeData = [];
            const expenseData = [];

            for (let i = 5; i >= 0; i--) {
                const d = new Date();
                d.setMonth(d.getMonth() - i);
                const yearMonth = d.toISOString().substring(0, 7);
                const monthName = d.toLocaleString('pt-BR', { month: 'short', year: '2-digit' });
                months.push(monthName);

                let inc = 0;
                let exp = 0;
                state.transactions.forEach(t => {
                    if (t.date.startsWith(yearMonth)) {
                        if (t.type === 'income') inc += t.amount;
                        else exp += t.amount;
                    }
                });
                incomeData.push(inc);
                expenseData.push(exp);
            }

            const ctxCashflow = document.getElementById('cashflowChart').getContext('2d');
            if (cashflowChartInstance) cashflowChartInstance.destroy();

            cashflowChartInstance = new Chart(ctxCashflow, {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [
                        { label: 'Receitas', data: incomeData, backgroundColor: '#10b981', borderRadius: 6 },
                        { label: 'Despesas', data: expenseData, backgroundColor: '#f43f5e', borderRadius: 6 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { labels: { color: '#94a3b8', font: { family: 'Inter' } } }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { color: '#94a3b8' } },
                        y: { grid: { color: '#334155' }, ticks: { color: '#94a3b8' } }
                    }
                }
            });
        }

        function formatCurrency(value) {
            return value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
        }

        function formatDate(dateStr) {
            const parts = dateStr.split('-');
            if (parts.length !== 3) return dateStr;
            return `${parts[2]}/${parts[1]}/${parts[0]}`;
        }

        window.toggleDarkMode = function() {
            const html = document.documentElement;
            const icon = document.getElementById('theme-icon');
            if (html.classList.contains('dark')) {
                html.classList.remove('dark');
                document.body.className = "bg-slate-100 text-slate-800 min-h-screen flex flex-col transition-colors duration-300";
                icon.setAttribute('data-lucide', 'moon');
            } else {
                html.classList.add('dark');
                document.body.className = "bg-slate-900 text-slate-100 min-h-screen flex flex-col transition-colors duration-300";
                icon.setAttribute('data-lucide', 'sun');
            }
            lucide.createIcons();
        };
    </script>
</body>
</html>
